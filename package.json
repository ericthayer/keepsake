{
  "name": "life-locker",
  "version": "1.0.0",
  "private": true,
  "description": "An encrypted, local-first locker of account and document locations for your family.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "npm run build && node --test \"tests/e2e/**/*.test.ts\""
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "typescript": "6.0.2"
  }
}
